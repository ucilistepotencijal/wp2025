@{
    ViewData["Title"] = "Početna - Auto Servis";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Auto Servis Sustav</h1>
        <p class="lead text-white-50">Profesionalno održavanje i upravljanje vašim voznim parkom</p>
    </div>

    <div class="selection-wrapper">

        <div class="selection-row row-vehicles">
            <div class="selection-label">Odaberi svoje vozilo:</div>
            <a asp-controller="Vehicles" asp-action="Index" class="btn-garage btn-vehicles">
                Vozila
            </a>
        </div>

        <div class="selection-row row-services">
            <div class="selection-label">Pregledaj dostupne usluge:</div>
            <a asp-controller="ServiceTypes" asp-action="Index" class="btn-garage btn-services">
                Usluge
            </a>
        </div>

        <div class="selection-row row-appointments">
            <div class="selection-label">Rezerviraj svoj termin:</div>
            <a asp-controller="Appointments" asp-action="Index" class="btn-garage btn-appointments">
                Termini
            </a>
        </div>

    </div>
</div>